# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
*.egg-info/

# Environment and local settings
.env
.claude/settings.local.json

# Data (too large)
/data/
amaai-lab___midi_caps/
token_frequencies.pt

# Logs: ignore everything under logs/, keep only the directory skeleton
logs/*
!logs/checkpoints/
logs/checkpoints/*
!logs/checkpoints/.gitkeep
!logs/wandb/
logs/wandb/*
!logs/wandb/.gitkeep
!logs/slurm/
logs/slurm/*
!logs/slurm/.gitkeep
!logs/out/
logs/out/*
!logs/out/.gitkeep
!logs/err/
logs/err/*
!logs/err/.gitkeep
# nested logs/ directories (e.g. midit/logs/)
*/**/logs/
*.log

# Checkpoints and archives
*.ckpt
*.zip
*.tar.gz

# Outputs
outputs/
multirun/
results/
generated_*/
figures/debug_*.png
tmp/

# Lockfiles (uv.lock is tracked)
*.lock
!uv.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
